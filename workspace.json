{
    "name": "LLM Chess",
    "module": "llm_chess",
    "repository": "git@github.com:fako/llm_chess.git",
    "branch": null,
    "runtimes": {
        "web": {
            "type": "django",
            "module": "web",
            "primary": true,
            "expose": null,
            "configuration": {
                "subdomain": "chess"
            }
        },
        "worker": {
            "type": "celery",
            "module": "web",
            "primary": false,
            "expose": null,
            "configuration": {}
        }
    },
    "environment": [
        "ACCOUNTS_EMAIL_VERIFICATION",
        "ANTHROPIC_API_KEY",
        "DJANGO_DEBUG",
        "DJANGO_SECRET_KEY"
    ],
    "command_sets": {
        "statics": [
            "npm ci",
            "venv/bin/invoke web.build-statics"
        ],
        "translations": [
            "venv/bin/invoke web.compile-messages"
        ],
        "migration": [
            "venv/bin/python manage.py migrate"
        ],
        "v2_puzzles": [
            "venv/bin/python manage.py migrate",
            "venv/bin/python manage.py loaddata initial_puzzles"
        ],
        "install": [
            "venv/bin/python manage.py createsuperuser",
            "venv/bin/python manage.py loaddata initial_puzzles"
        ]
    },
    "pre_install": [
        "statics",
        "translations"
    ],
    "post_install": [
        "migration",
        "install"
    ],
    "pre_deploy": [
        "statics",
        "translations"
    ],
    "post_deploy": null
}
