{
    "name": "LLM Chess",
    "module": "llm_chess",
    "repository": "git@github.com:fako/llm_chess.git",
    "branch": null,
    "runtimes": {
        "web": {
            "type": "django",
            "module": "web",
            "primary": true,
            "expose": null,
            "configuration": {}
        },
        "worker": {
            "type": "celery",
            "module": "web",
            "primary": false,
            "expose": null,
            "configuration": {}
        }
    },
    "environment": [
        "ANTHROPIC_API_KEY"
    ],
    "command_sets": {
        "statics": [
            "npm ci",
            "venv/bin/invoke web.build-statics"
        ],
        "migration": [
            "venv/bin/python manage.py migrate"
        ],
        "install": [
            "venv/bin/python manage.py createsuperuser",
            "venv/bin/python manage.py loaddata initial_puzzles"
        ]
    },
    "pre_install": "statics",
    "post_install": [
        "migration",
        "install"
    ],
    "pre_deploy": "statics",
    "post_deploy": null
}
