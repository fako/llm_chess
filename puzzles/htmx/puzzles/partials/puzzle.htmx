{% set progress = state.progress %}
{% macro puzzle_link(target, symbol, label) -%}
  {% if target %}
    <a href="{{ url('puzzles:puzzle', kwargs={'pk': target.pk}) }}" class="btn-secondary btn-sm shrink-0 px-2" aria-label="{{ label }}" title="{{ label }}">{{ symbol }}</a>
  {% else %}
    <button type="button" class="btn-secondary btn-sm shrink-0 px-2" aria-label="{{ label }}" disabled>{{ symbol }}</button>
  {% endif %}
{%- endmacro %}
{% set action_url = url('puzzles:puzzle_action', kwargs={'pk': puzzle.pk, 'action': 'ACTION'}) %}
<div id="puzzle" class="space-y-4"
     data-phase="{{ state.phase.value }}"
     data-color="{{ puzzle.perspective }}"
     data-move-url="{{ action_url|replace('ACTION', 'move') }}"
     data-legal='{{ state.legal_moves|tojson }}'
     data-labels='{{ {"promote": _("puzzles.board.promote_to"), "q": _("puzzles.board.queen"),
                      "r": _("puzzles.board.rook"), "b": _("puzzles.board.bishop"),
                      "n": _("puzzles.board.knight")}|tojson }}'>

  <div class="flex items-end justify-between gap-3">
    <div class="min-w-0">
      <h1 class="truncate font-serif text-2xl">{{ puzzle.title or category.name }}</h1>
      <p class="text-sm text-muted">
        <span class="mr-1 inline-block h-3 w-3 rounded-full border border-ink/40 align-[-1px]
                     {{ 'bg-white' if puzzle.perspective == 'white' else 'bg-ink' }}"></span>
        {% if puzzle.perspective == 'white' -%}
          {{ _("puzzles.puzzle.white_to_play", task=category.task) }}
        {%- else -%}
          {{ _("puzzles.puzzle.black_to_play", task=category.task) }}
        {%- endif %}
      </p>
    </div>
    <div class="shrink-0 text-right text-xs text-muted">
      <div>
        {%- if state.phase.value == 'move' %}{{ _("puzzles.stats.remaining", count=state.moves_left) }} · {% endif -%}
        {{ _("puzzles.stats.wrong", count=progress.wrong_moves) }} ·
        {{- " " ~ ngettext("puzzles.stats.hints", "puzzles.stats.hints.plural", progress.hints_used) }}
      </div>
    </div>
  </div>

  <div class="px-[7px]">
    <div class="board" role="grid" aria-label="{{ _('puzzles.board.label') }}">
      {% for square in squares %}
        <button type="button" data-square="{{ square.name }}"
                {% if square.piece %}data-piece="{{ square.piece }}"{% endif %}
                {% if square.is_own %}data-own{% endif %}
                aria-label="{{ square.name }}"
                class="square {{ 'light' if square.is_light else 'dark' }}{{ ' occupied' if square.piece }}{{ ' last-move' if square.is_last_move }}{{ ' hint' if square.is_hint }}{{ ' wrong' if square.is_wrong }}">
          {% if square.piece %}
            <svg class="piece" viewBox="0 0 45 45" aria-hidden="true"><use href="#{{ piece_id(square.piece) }}"></use></svg>
          {% endif %}
          {% if square.rank_label %}<span class="coordinate rank">{{ square.rank_label }}</span>{% endif %}
          {% if square.file_label %}<span class="coordinate file">{{ square.file_label }}</span>{% endif %}
        </button>
      {% endfor %}
    </div>
  </div>

  {% if state.phase.value == 'move' %}
    {% if puzzle.hint and progress.hint_level >= 1 and not progress.line %}
      <p class="rounded-lg bg-sage/15 px-3 py-2 text-center text-sm text-ink">{{ puzzle.hint }}</p>
    {% endif %}
    <div class="flex items-stretch gap-2">
      {{ puzzle_link(previous_puzzle, '‹', _('puzzles.puzzle.previous')) }}
      <button class="btn-secondary btn-sm min-w-0 flex-1" hx-post="{{ action_url|replace('ACTION', 'hint') }}"
              hx-target="#puzzle" hx-swap="outerHTML"
              {% if progress.hint_level >= 2 %}disabled{% endif %}>
        {% if progress.hint_level == 0 %}{{ _("puzzles.puzzle.hint") }}{% elif progress.hint_level == 1 %}{{ _("puzzles.puzzle.show_move") }}{% else %}{{ _("puzzles.puzzle.shown") }}{% endif %}
      </button>
      <button class="btn-secondary btn-sm min-w-0 flex-1" hx-post="{{ action_url|replace('ACTION', 'restart') }}"
              hx-target="#puzzle" hx-swap="outerHTML" {% if not progress.line %}disabled{% endif %}>
        {{ _("puzzles.puzzle.start_over") }}
      </button>
      {{ puzzle_link(next_puzzle, '›', _('puzzles.puzzle.next')) }}
    </div>
  {% else %}
    <a href="{{ url('puzzles:category', kwargs={'slug': category.slug}) }}" class="btn-primary w-full">{{ _("puzzles.puzzle.next") }}</a>
  {% endif %}
</div>
