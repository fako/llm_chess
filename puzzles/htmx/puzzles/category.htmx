{% extends "base.htmx" %}
{% block title %}{{ category.name }} · LLM Chess{% endblock %}
{% block content %}
  <div class="space-y-5">
    <div>
      <a href="{{ url('puzzles:home') }}" class="text-sm text-muted hover:text-walnut">&larr; {{ _("puzzles.category.back") }}</a>
      <h1 class="mt-1 font-serif text-3xl">{{ category.name }}</h1>
    </div>
    {% if not has_puzzles %}
      <div class="card p-5 text-muted">{{ _("puzzles.category.empty") }}</div>
    {% else %}
      <div class="card p-5">
        <h2 class="font-serif text-xl">{{ _("puzzles.category.done") }}</h2>
        <p class="mt-1 text-muted">{{ _("puzzles.category.done_intro") }}</p>
      </div>
    {% endif %}
  </div>
{% endblock %}
