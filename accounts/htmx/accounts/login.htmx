{% extends "base.htmx" %}
{% block title %}{{ _("accounts.login.title") }} · {{ _("site.name") }}{% endblock %}
{% block content %}
  <div class="space-y-5">
    <div>
      <h1 class="font-serif text-3xl">{{ _("accounts.login.heading") }}</h1>
      <p class="mt-1 text-muted">{{ _("accounts.login.intro") }}</p>
    </div>
    {% with submit=_("accounts.login.submit") %}{% include "accounts/_form.htmx" %}{% endwith %}
    <p class="text-center text-sm text-muted">
      <a href="{{ url('accounts:password_reset') }}" class="font-medium text-walnut underline underline-offset-4">{{ _("accounts.login.forgot_password") }}</a>
    </p>
    <p class="text-center text-sm text-muted">
      {{ _("accounts.login.new_here") }} <a href="{{ url('accounts:signup') }}{{ '?' ~ {'next': next}|urlencode if next }}" class="font-medium text-walnut underline underline-offset-4">{{ _("accounts.login.signup_link") }}</a>
    </p>
  </div>
{% endblock %}
