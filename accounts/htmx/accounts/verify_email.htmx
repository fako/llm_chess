{% extends "base.htmx" %}
{% block title %}{{ _("accounts.verify_email.title") }} · LLM Chess{% endblock %}
{% block content %}
  <div class="card space-y-2 p-5">
    <h1 class="font-serif text-3xl">{{ _("accounts.verify_email.title") }}</h1>
    <p class="text-muted">
      {% if email %}
        {% set address %}<strong class="text-ink">{{ email }}</strong>{% endset %}
      {% else %}
        {% set address = _("accounts.verify_email.your_address") %}
      {% endif %}
      {{ _("accounts.verify_email.sent", address=address) }}
    </p>
  </div>
{% endblock %}
