{% extends "base.htmx" %}
{% block title %}{{ _("accounts.password_reset_confirm.title") }} · {{ _("site.name") }}{% endblock %}
{% block content %}
  {% if validlink %}
    <div class="space-y-5">
      <h1 class="font-serif text-3xl">{{ _("accounts.password_reset_confirm.title") }}</h1>
      {% with submit=_("accounts.password_reset_confirm.submit"), next=None %}{% include "accounts/_form.htmx" %}{% endwith %}
    </div>
  {% else %}
    <div class="card space-y-4 p-5">
      <div>
        <h1 class="font-serif text-3xl">{{ _("accounts.password_reset_confirm.title") }}</h1>
        <p class="mt-1 text-muted">{{ _("accounts.password_reset_confirm.invalid") }}</p>
      </div>
      <a href="{{ url('accounts:password_reset') }}" class="btn-secondary w-full">{{ _("accounts.password_reset_confirm.again") }}</a>
    </div>
  {% endif %}
{% endblock %}
