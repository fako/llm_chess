{% extends "base.htmx" %}
{% block title %}Password changed · LLM Chess{% endblock %}
{% block content %}
  <div class="card space-y-4 p-5">
    <div>
      <h1 class="font-serif text-3xl">Password changed</h1>
      <p class="mt-1 text-muted">Use your new password the next time you log in.</p>
    </div>
    <a href="{{ url('accounts:profile') }}" class="btn-secondary w-full">Back to my results</a>
  </div>
{% endblock %}
