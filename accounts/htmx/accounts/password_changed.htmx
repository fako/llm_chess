{% extends "base.htmx" %}
{% block title %}{{ _("accounts.password_changed.title") }} · LLM Chess{% endblock %}
{% block content %}
  <div class="card space-y-4 p-5">
    <div>
      <h1 class="font-serif text-3xl">{{ _("accounts.password_changed.title") }}</h1>
      <p class="mt-1 text-muted">{{ _("accounts.password_changed.intro") }}</p>
    </div>
    <a href="{{ url('accounts:profile') }}" class="btn-secondary w-full">{{ _("accounts.password_changed.back") }}</a>
  </div>
{% endblock %}
