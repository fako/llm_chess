{% extends "base.htmx" %}
{% block title %}{{ _("accounts.password_reset_done.title") }} · {{ _("site.name") }}{% endblock %}
{% block content %}
  <div class="card space-y-4 p-5">
    <div>
      <h1 class="font-serif text-3xl">{{ _("accounts.password_reset_done.title") }}</h1>
      <p class="mt-1 text-muted">{{ _("accounts.password_reset_done.intro") }}</p>
    </div>
    <a href="{{ url('accounts:login') }}" class="btn-primary w-full">{{ _("accounts.password_reset_done.login") }}</a>
  </div>
{% endblock %}
