{% extends "base.htmx" %}
{% block title %}{{ _("accounts.password_reset.title") }} · {{ _("site.name") }}{% endblock %}
{% block content %}
  <div class="space-y-5">
    <div>
      <h1 class="font-serif text-3xl">{{ _("accounts.password_reset.title") }}</h1>
      <p class="mt-1 text-muted">{{ _("accounts.password_reset.intro") }}</p>
    </div>
    {% with submit=_("accounts.password_reset.submit"), next=None %}{% include "accounts/_form.htmx" %}{% endwith %}
    <p class="text-center text-sm text-muted">
      <a href="{{ url('accounts:login') }}" class="font-medium text-walnut underline underline-offset-4">{{ _("accounts.password_reset.back") }}</a>
    </p>
  </div>
{% endblock %}
