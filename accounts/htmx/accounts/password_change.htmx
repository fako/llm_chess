{% extends "base.htmx" %}
{% block title %}{{ _("accounts.password_change.title") }} · LLM Chess{% endblock %}
{% block content %}
  <div class="space-y-5">
    <div>
      <a href="{{ url('accounts:profile') }}" class="text-sm text-muted hover:text-walnut">&larr; {{ _("web.menu.my_results") }}</a>
      <h1 class="mt-1 font-serif text-3xl">{{ _("accounts.password_change.title") }}</h1>
    </div>
    {% with submit=_("accounts.password_change.submit"), next=None %}{% include "accounts/_form.htmx" %}{% endwith %}
  </div>
{% endblock %}
