{% extends "base.htmx" %}
{% block title %}Change password · LLM Chess{% endblock %}
{% block content %}
  <div class="space-y-5">
    <div>
      <a href="{{ url('accounts:profile') }}" class="text-sm text-muted hover:text-walnut">&larr; My results</a>
      <h1 class="mt-1 font-serif text-3xl">Change password</h1>
    </div>
    {% with submit="Change password", next=None %}{% include "accounts/_form.htmx" %}{% endwith %}
  </div>
{% endblock %}
